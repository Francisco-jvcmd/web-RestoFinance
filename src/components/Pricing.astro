---
const whatsappLink = "https://wa.me/593998896340?text=¡Hola!%20Vengo%20de%20la%20página%20web%20y%20estoy%20interesado%20en%20adquirir%20la%20licencia%20de%20RestoFinance.%20¿Me%20podrías%20ayudar%20con%20los%20pasos%20para%20la%20compra?%20¡Gracias!";
---
<section class="py-24 bg-brand-cream-light" id="precios">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold text-brand-teal bg-brand-teal-light px-3 py-1 rounded-full uppercase tracking-wider">
        Planes de Licencia
      </span>
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-brand-navy tracking-tight mt-3 mb-4">
        Elige el plan ideal para tu restaurante
      </h2>
      <p class="text-sm sm:text-base text-brand-navy/70 leading-relaxed">
        Licencias transparentes en dólares estadounidenses (USD) sin contratos forzosos. Todo se procesa de forma directa y personalizada a través de WhatsApp.
      </p>
    </div>

    <!-- Pricing Grid (2 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-4xl mx-auto items-stretch">
      
      <!-- Card 1: Monthly Plan -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-brand-orange/10 shadow-sm hover:shadow-xl hover:scale-[1.01] transition-all duration-300 flex flex-col justify-between relative group">
        <div>
          <!-- Header -->
          <div class="mb-6">
            <h3 class="text-lg font-bold text-brand-navy font-display">Licencia Mensual</h3>
            <p class="text-xs text-brand-navy/60 mt-1">Flexibilidad total sin contratos</p>
          </div>

          <!-- Price -->
          <div class="flex items-baseline gap-1.5 mb-8">
            <span class="text-4xl sm:text-5xl font-display font-extrabold text-brand-navy">$12.00</span>
            <span class="text-xs font-semibold text-brand-navy/60">/ mes</span>
          </div>

          <div class="h-px bg-brand-orange/10 w-full mb-8"></div>

          <!-- Features List -->
          <ul class="space-y-4 mb-8 text-sm text-brand-navy/85">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Uso offline 100% garantizado</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Todos los módulos activos (sin límites)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Reportes de ventas detallados</span>
            </li>
            <li class="flex items-start gap-3 text-brand-navy/50">
              <svg class="w-5 h-5 text-brand-navy/30 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Soporte prioritario no incluido (estándar)</span>
            </li>
          </ul>
        </div>

        <!-- CTA -->
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center px-6 py-4 rounded-2xl text-sm font-extrabold text-brand-teal hover:text-white bg-brand-teal-light hover:bg-brand-teal border-2 border-brand-teal/20 hover:border-brand-teal shadow-md transition-all duration-200"
        >
          Comprar Licencia Mensual
        </a>
      </div>

      <!-- Card 2: Annual Plan (Featured) -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 border-2 border-brand-orange shadow-lg shadow-brand-orange/5 hover:shadow-2xl hover:scale-[1.01] transition-all duration-300 flex flex-col justify-between relative group ring-4 ring-brand-orange/5">
        
        <!-- Popular Badge -->
        <span class="absolute -top-3.5 right-6 bg-brand-orange text-white text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
          Ahorra Más del 20%
        </span>

        <div>
          <!-- Header -->
          <div class="mb-6">
            <h3 class="text-lg font-bold text-brand-navy font-display flex items-center gap-2">
              Licencia Anual
              <span class="text-[10px] px-2 py-0.5 rounded bg-brand-teal-light text-brand-teal border border-brand-teal/20 font-bold uppercase">Popular</span>
            </h3>
            <p class="text-xs text-brand-navy/60 mt-1">El plan preferido para negocios en crecimiento</p>
          </div>

          <!-- Price -->
          <div class="flex items-baseline gap-1.5 mb-2">
            <span class="text-4xl sm:text-5xl font-display font-extrabold text-brand-navy">$100.00</span>
            <span class="text-xs font-semibold text-brand-navy/60">/ año</span>
          </div>
          <!-- Savings Callout -->
          <p class="text-xs font-bold text-brand-orange mb-6 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.317.766-.599 1.678-.83 2.586a17.28 17.28 0 00-.54 2.813 8.286 8.286 0 01-3.037-1.243 1 1 0 00-1.411.136 4.703 4.703 0 00-.007 6.408c.154.161.34.298.548.408a8.84 8.84 0 005.05 1.026 5.48 5.48 0 003.54-1.395c.047-.044.093-.089.139-.135a5.004 5.004 0 001.423-3.488c0-1.366-.76-2.614-1.7-3.717-.124-.145-.252-.288-.382-.43a12.13 12.13 0 01-.654-1.89c-.114-.393-.2-.785-.25-1.16a10.985 10.985 0 00-.325-1.383c-.04-.136-.076-.27-.115-.402z" clip-rule="evenodd"></path></svg>
            Ahorras $44 al año (¡Más de 3 meses gratis!)
          </p>

          <div class="h-px bg-brand-orange/10 w-full mb-8"></div>

          <!-- Features List -->
          <ul class="space-y-4 mb-8 text-sm text-brand-navy/85">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Uso offline 100% garantizado</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Todos los módulos activos (sin límites)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Actualizaciones gratuitas todo el año</span>
            </li>
            <li class="flex items-start gap-3 font-bold text-brand-teal">
              <svg class="w-5 h-5 text-brand-teal shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Soporte prioritario 24/7 incluido</span>
            </li>
          </ul>
        </div>

        <!-- CTA -->
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center px-6 py-4 rounded-2xl text-sm font-extrabold text-white bg-brand-orange hover:bg-brand-orange-hover hover:scale-[1.01] hover:shadow-xl hover:shadow-brand-orange/20 active:scale-[0.99] transition-all duration-250 border-2 border-transparent"
        >
          Comprar Licencia Anual
        </a>
      </div>

    </div>

    <!-- Security & Guarantee Badge -->
    <div class="mt-16 text-center max-w-xl mx-auto p-6 rounded-2xl border border-brand-orange/5 bg-white/50 backdrop-blur-sm">
      <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5 flex items-center justify-center gap-1.5">
        <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        Garantía de Satisfacción RestoFinance
      </h4>
      <p class="text-xs text-brand-navy/60 leading-relaxed">
        Adquiere tu licencia con total confianza. El proceso se realiza a través de nuestro canal verificado de WhatsApp donde te daremos soporte paso a paso para la activación remota.
      </p>
    </div>

  </div>
</section>
