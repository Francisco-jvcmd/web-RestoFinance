<!-- Dashboard de Expansión: Script auto-contenido (CSS + JS) -->
<script is:inline>
  (function() {
    // ═══ INYECTAR CSS PROPIO (evita conflictos con Tailwind) ═══
    var css = document.createElement('style');
    css.textContent = '@keyframes ec-dash-flow{to{stroke-dashoffset:-20}}.ec-circuit{stroke-dasharray:2 5;animation:ec-dash-flow 3s linear infinite;}';
    document.head.appendChild(css);

    // ═══ SISTEMA DE CONTADOR AUTO-INCREMENTAL ═══
    var LAUNCH = new Date('2026-06-01T00:00:00');
    var PROVS = [
      { id: 'quito',         name: 'Quito',        base: 18, min: 3, max: 5 },
      { id: 'guayaquil',     name: 'Guayaquil',    base: 12, min: 2, max: 4 },
      { id: 'cuenca',        name: 'Cuenca',       base: 8,  min: 2, max: 3 },
      { id: 'santo-domingo', name: 'Sto. Domingo', base: 5,  min: 1, max: 3 },
      { id: 'manta',         name: 'Manta',        base: 4,  min: 1, max: 2 },
      { id: 'ambato',        name: 'Ambato',       base: 6,  min: 1, max: 3 },
      { id: 'machala',       name: 'Machala',      base: 3,  min: 1, max: 2 },
      { id: 'loja',          name: 'Loja',         base: 2,  min: 1, max: 2 },
    ];

    function srand(s) {
      var x = Math.sin(s * 9301 + 49297) * 233280;
      return x - Math.floor(x);
    }

    function daysSince() {
      return Math.max(0, Math.floor((Date.now() - LAUNCH.getTime()) / 86400000));
    }

    function getDL(p, i) {
      var d = daysSince(), t = p.base;
      for (var j = 1; j <= d; j++) {
        var r = srand(i * 1000 + j);
        t += p.min + Math.floor(r * (p.max - p.min + 1));
      }
      return t;
    }

    // Calcular descargas
    var counts = {}, total = 0, maxC = 0;
    PROVS.forEach(function(p, i) {
      var c = getDL(p, i);
      counts[p.id] = c;
      total += c;
      if (c > maxC) maxC = c;
    });

    // ═══ ACTUALIZAR CONTADORES EN TOOLTIPS ═══
    PROVS.forEach(function(p) {
      var el = document.getElementById('count-' + p.id);
      if (el) el.textContent = counts[p.id];
      var bar = document.getElementById('bar-' + p.id);
      if (bar) bar.style.width = Math.round((counts[p.id] / maxC) * 100) + '%';
    });

    // ═══ CREAR ETIQUETAS VISIBLES (nombre + descargas) ═══
    var isSmall = window.innerWidth < 640;
    PROVS.forEach(function(p, i) {
      var hs = document.querySelector('.ec-hotspot[data-idx="' + i + '"]');
      if (!hs) return;
      var lbl = document.createElement('span');
      lbl.style.cssText = 'position:absolute;top:' + (isSmall ? '10px' : '14px') + ';left:50%;transform:translateX(-50%);'
        + 'background:rgba(10,31,68,0.88);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);'
        + 'color:#fff;font-size:' + (isSmall ? '5.5px' : '7px') + ';font-weight:700;'
        + 'padding:' + (isSmall ? '1px 4px' : '2px 6px') + ';border-radius:4px;'
        + 'white-space:nowrap;pointer-events:none;box-shadow:0 1px 4px rgba(0,0,0,0.2);'
        + 'letter-spacing:0.02em;z-index:15;';
      lbl.textContent = p.name + ' \u00B7 ' + counts[p.id];
      hs.appendChild(lbl);
    });

    // ═══ ANIMACIÓN ODÓMETRO ═══
    var counterEl = document.getElementById('total-dl-counter');
    if (counterEl) {
      var startT = performance.now();
      function tick(now) {
        var prog = Math.min((now - startT) / 2000, 1);
        var ease = 1 - Math.pow(1 - prog, 3);
        counterEl.textContent = Math.floor(ease * total);
        if (prog < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // ═══ HOTSPOTS: Quitar clases Tailwind + animar con inline styles ═══
    var spots = document.querySelectorAll('.ec-hotspot');
    // Paso 1: Preparar estado inicial (quitar clases de Tailwind que bloquean)
    spots.forEach(function(el) {
      el.classList.remove('opacity-0', 'scale-0');
      el.style.opacity = '0';
      el.style.transform = 'scale(0)';
      el.style.transition = 'opacity 0.6s cubic-bezier(0.34,1.56,0.64,1), transform 0.6s cubic-bezier(0.34,1.56,0.64,1)';
    });
    // Paso 2: Mostrar secuencialmente (onda desde Quito)
    spots.forEach(function(el, i) {
      setTimeout(function() {
        el.style.opacity = '1';
        el.style.transform = 'scale(1)';
      }, 400 + i * 280);
    });

    // ═══ CIRCUITOS: Animar con inline styles ═══
    var lines = document.querySelectorAll('.ec-circuit');
    lines.forEach(function(el, i) {
      el.style.opacity = '0';
      el.style.transition = 'opacity 0.8s ease';
      setTimeout(function() {
        el.style.opacity = '1';
      }, 600 + i * 180);
    });
  })();
</script>

