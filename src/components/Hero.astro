      <!-- Icon content -->
    </div>
    <div>
      <h4 class="text-xs font-extrabold text-white" id="toast-title">Acción realizada</h4>
      <p class="text-[11px] text-white/70 mt-0.5" id="toast-message">Mensaje del sistema.</p>
    </div>
  </div>

<!-- Interactive Script for Download Toast -->
<script>
  const downloadHeroBtn = document.getElementById('btn-download-hero');
  const toast = document.getElementById('toast-notification');
  const toastTitle = document.getElementById('toast-title');
  const toastMessage = document.getElementById('toast-message');
  const toastIconWrapper = document.getElementById('toast-icon-wrapper');

  function showToast(title, message, type = 'download') {
    if (!toast || !toastTitle || !toastMessage || !toastIconWrapper) return;

    toastTitle.textContent = title;
    toastMessage.textContent = message;

    if (type === 'download') {
      toastIconWrapper.innerHTML = `
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
      `;
      toastIconWrapper.className = 'bg-brand-teal p-1.5 rounded-xl shrink-0';
    }

    toast.classList.remove('translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-24', 'opacity-0');
    }, 4000);
  }

  if (downloadHeroBtn) {
    downloadHeroBtn.addEventListener('click', () => {
      showToast(
        '¡Descarga Iniciada!', 
        'El instalador "RestoFinance_1.0.0_x64-setup.exe" se está preparando para descargar. Revisa tus descargas.', 
        'download'
      );
    });
  }

  // Listen to custom event dispatched by other components (like the download button in Installation.astro)
  window.addEventListener('show-toast', (e: any) => {
    if (e.detail) {
      showToast(e.detail.title, e.detail.message, e.detail.type);
    }
  });
</script>
