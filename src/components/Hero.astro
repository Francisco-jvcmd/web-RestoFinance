---
---
<section class="relative bg-gradient-to-b from-brand-cream-light via-brand-cream to-brand-cream-light pt-12 pb-24 overflow-hidden" id="hero">
  
  <!-- Subtle decorative elements -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[1000px] h-[350px] bg-brand-orange/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-40 left-10 w-72 h-72 bg-brand-teal/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Split Hero Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-16">
      
      <!-- Left Column: Marketing Message -->
      <div class="lg:col-span-7 text-center lg:text-left flex flex-col items-center lg:items-start">
        
        <!-- Trust badge -->
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-brand-teal-light text-brand-teal border border-brand-teal/20 mb-6 select-none">
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          Seguridad 100% Local &bull; Sin Internet
        </span>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-extrabold tracking-tight text-brand-navy leading-[1.1] mb-6">
          ¡Deja de perder dinero <span class="text-brand-orange">sin saberlo</span>!
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-brand-navy/75 max-w-2xl leading-relaxed mb-6 font-semibold">
          Controla tus ventas, gastos y ganancias reales desde tu celular o computador.
        </p>

        <!-- Ecuadorian Localized Hook -->
        <p class="text-sm sm:text-base font-semibold text-brand-teal bg-brand-teal-light px-5 py-3 rounded-2xl border border-brand-teal/20 max-w-2xl mb-8 leading-relaxed shadow-sm">
          RestoFinance es el único sistema diseñado para restaurantes ecuatorianos que quieren saber exactamente cuánto ganan cada día.
        </p>

        <!-- CTA and Meta details -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 w-full sm:w-auto">
          <a 
            href="https://github.com/Francisco-jvcmd/RestoFinance-Instalador/releases/download/v1.0.0/RestoFinance_1.0.0_x64-setup.exe" 
            id="btn-download-hero"
            class="group w-full sm:w-auto inline-flex items-center justify-between sm:justify-center gap-4 px-8 py-4 rounded-2xl text-left bg-brand-orange hover:bg-brand-orange-hover text-white shadow-xl shadow-brand-orange/20 hover:shadow-2xl hover:shadow-brand-orange/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-orange focus:ring-offset-2"
          >
            <div class="shrink-0 bg-white/10 p-2 rounded-xl">
              <!-- Windows Icon -->
              <svg class="w-6 h-6 fill-current text-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 3.449L9.75 2.1v9.45H0V3.449zM0 12.45h9.75v9.45L0 20.551v-8.102zM10.95 1.95L24 0v11.55H10.95V1.95zM10.95 12.45H24v9.6L10.95 22.05v-9.6z"/>
              </svg>
            </div>
            <div>
              <span class="block text-sm font-medium text-brand-orange-light/80 leading-none">Última versión disponible</span>
              <span class="block text-lg font-bold mt-0.5">Descargar RestoFinance</span>
            </div>
          </a>

          <a 
            href="#precios"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-5 rounded-2xl text-base font-bold text-brand-navy hover:text-brand-orange bg-white border-2 border-brand-navy/10 hover:border-brand-orange/30 shadow-md hover:shadow-lg transition-all duration-200"
          >
            Ver planes de licencia
          </a>
        </div>

        <!-- Trust Badges (Three Checkmarks Corregidos) -->
        <div class="mt-8 flex flex-col sm:flex-row flex-wrap justify-center lg:justify-start gap-x-6 gap-y-3 text-xs sm:text-sm font-bold text-brand-navy/80">
          <span class="flex items-center gap-2">
            <span class="text-brand-teal text-base">✅</span>
            Registra ventas con un solo clic
          </span>
          <span class="flex items-center gap-2">
            <span class="text-brand-teal text-base">✅</span>
            Conoce tu ganancia real al cerrar el día
          </span>
          <span class="flex items-center gap-2">
            <span class="text-brand-teal text-base">✅</span>
            Toma decisiones con números, no con suposiciones
          </span>
        </div>
      </div>

      <!-- Right Column: Dashboard de Expansión en Tiempo Real -->
      <div class="lg:col-span-5 w-full flex justify-center items-center relative py-4">
        <div class="relative w-full max-w-[460px] rounded-3xl bg-white/60 backdrop-blur-md border border-brand-teal/10 shadow-2xl flex flex-col overflow-hidden">
          
          <!-- Degradado de brillo interno premium -->
          <div class="absolute inset-0 bg-gradient-to-br from-brand-teal/5 via-transparent to-brand-orange/5 pointer-events-none"></div>
          <div class="absolute -top-20 -right-20 w-40 h-40 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-20 -left-20 w-40 h-40 bg-brand-teal/10 rounded-full blur-3xl pointer-events-none"></div>

          <!-- ═══ HEADER: Título + Badge EN VIVO ═══ -->
          <div class="relative z-10 px-4 pt-4 pb-3 sm:px-5 sm:pt-5">
            <div class="flex items-center justify-between border-b border-brand-teal/10 pb-3 select-none">
              <div>
                <span class="text-[8px] sm:text-[9px] font-bold text-brand-teal uppercase tracking-[0.15em] block">Expansión en Ecuador</span>
                <h3 class="text-[11px] sm:text-xs font-display font-extrabold text-brand-navy mt-0.5">Dashboard de Descargas</h3>
              </div>
              <span class="flex items-center gap-1 text-[8px] sm:text-[9px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full border border-emerald-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                EN VIVO
              </span>
            </div>

            <!-- ═══ ODÓMETRO TOTAL ═══ -->
            <div class="mt-3 flex items-center gap-3">
