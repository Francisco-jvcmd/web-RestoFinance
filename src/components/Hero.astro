                </svg>
              </div>
              <div>
                <div class="flex items-baseline gap-1.5">
                  <span id="total-dl-counter" class="text-2xl sm:text-3xl font-display font-black text-brand-navy tabular-nums tracking-tight">0</span>
                  <span class="text-[9px] sm:text-[10px] font-bold text-brand-orange">📥</span>
                </div>
                <span class="block text-[8px] sm:text-[9px] text-brand-navy/55 font-semibold -mt-0.5">descargas totales en Ecuador</span>
              </div>
            </div>
          </div>

