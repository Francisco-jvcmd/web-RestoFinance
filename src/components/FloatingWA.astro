---
const whatsappNumber = "593998896340";
const message = "¡Hola RestoFinance! Me gustaría recibir más información y asesoramiento sobre el sistema POS para mi restaurante.";
const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 pointer-events-none group">
  <!-- Interactive Label/Tooltip (visible on desktop hover, and slides in shortly after load) -->
  <div 
    id="wa-tooltip"
    class="bg-white text-brand-navy text-xs font-bold px-4 py-2.5 rounded-2xl shadow-xl border border-brand-orange/10 opacity-0 -translate-x-4 pointer-events-auto transition-all duration-300 ease-out select-none hidden sm:block whitespace-nowrap"
  >
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      ¿Tienes dudas? ¡Pregúntanos aquí!
    </span>
  </div>

  <!-- WA Floating Button -->
  <a 
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    title="Chatear por WhatsApp"
    class="pointer-events-auto relative flex items-center justify-center w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white shadow-2xl hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-emerald-300/40"
  >
    <!-- Ripple Ring Animations -->
    <span class="absolute inset-0 rounded-full bg-emerald-500/30 animate-ping pointer-events-none scale-105"></span>
    <span class="absolute inset-0 rounded-full bg-emerald-500/20 animate-pulse pointer-events-none scale-125"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.66.986 3.288 1.498 4.79 1.499 5.426.002 9.841-4.41 9.843-9.843.001-2.632-1.023-5.105-2.883-6.967-1.86-1.862-4.331-2.887-6.966-2.888-5.43 0-9.843 4.41-9.845 9.845-.001 1.62.43 3.2 1.245 4.585L1.879 21.65l6.082-1.596-.314-.176zm9.288-5.111c-.304-.153-1.8-.886-2.08-.988-.278-.102-.482-.153-.684.153-.203.306-.785.988-.962 1.192-.178.205-.355.23-.659.077-.304-.153-1.284-.473-2.447-1.511-.904-.806-1.514-1.802-1.69-2.109-.178-.306-.019-.471.133-.623.137-.137.304-.355.456-.533.153-.178.204-.306.305-.51.102-.205.051-.383-.026-.537-.076-.153-.684-1.651-.937-2.26-.247-.595-.499-.515-.684-.524-.177-.01-.38-.01-.582-.01-.203 0-.533.076-.812.382-.28.306-1.066 1.043-1.066 2.544 0 1.502 1.091 2.953 1.244 3.157.153.204 2.148 3.28 5.203 4.601.727.314 1.293.502 1.734.643.73.232 1.395.2 1.92.122.585-.088 1.8-.737 2.054-1.451.253-.715.253-1.328.178-1.451-.076-.122-.278-.204-.582-.356z"/>
    </svg>
  </a>
</div>

<script>
  // Dynamic behavior to fade in tooltip shortly after page loads
  window.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('wa-tooltip');
    if (tooltip) {
      setTimeout(() => {
        tooltip.classList.remove('opacity-0', '-translate-x-4');
        tooltip.classList.add('opacity-100', 'translate-x-0');
      }, 2000);

      // Hide tooltip when scrolling down, show on desktop hover
      let lastScrollTop = 0;
      let ticking = false;

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            let st = window.pageYOffset || document.documentElement.scrollTop;
            if (st > lastScrollTop && st > 100) {
              // scroll down -> hide
              tooltip.classList.add('opacity-0', '-translate-x-4');
              tooltip.classList.remove('opacity-100', 'translate-x-0');
            } else if (st <= 100) {
              // scroll up/top -> show
              tooltip.classList.remove('opacity-0', '-translate-x-4');
              tooltip.classList.add('opacity-100', 'translate-x-0');
            }
            lastScrollTop = st <= 0 ? 0 : st;
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }
  });
</script>
