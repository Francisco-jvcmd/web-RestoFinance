<!-- DIAGNOSTIC ENGINE (JavaScript)                 -->
<!-- ═══════════════════════════════════════════════ -->
<script is:inline>
(function() {
  document.addEventListener('DOMContentLoaded', function() {

    // ── TAB TOGGLE LOGIC ──
    var tabInicioBtn = document.getElementById('tab-inicio-btn');
    var tabDiagnosticoBtn = document.getElementById('tab-diagnostico-btn');
    var viewInicio = document.getElementById('view-inicio');
    var viewDiagnostico = document.getElementById('view-diagnostico');
    var cardDiagnosticoBtn = document.getElementById('card-diagnostico-btn');

    function setActiveTab(tab) {
      if (tab === 'inicio') {
        viewInicio.classList.remove('hidden');
        viewDiagnostico.classList.add('hidden');
        tabInicioBtn.className = "flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer bg-brand-orange text-white shadow-md shadow-brand-orange/20";
        tabDiagnosticoBtn.className = "flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer text-brand-navy/60 hover:text-brand-orange hover:bg-brand-orange-light/40";
      } else if (tab === 'diagnostico') {
        viewInicio.classList.add('hidden');
        viewDiagnostico.classList.remove('hidden');
        tabDiagnosticoBtn.className = "flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer bg-brand-orange text-white shadow-md shadow-brand-orange/20";
        tabInicioBtn.className = "flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer text-brand-navy/60 hover:text-brand-orange hover:bg-brand-orange-light/40";
      }
    }

    if (tabInicioBtn) {
      tabInicioBtn.addEventListener('click', function() { setActiveTab('inicio'); });
    }
    if (tabDiagnosticoBtn) {
      tabDiagnosticoBtn.addEventListener('click', function() { setActiveTab('diagnostico'); });
    }
    if (cardDiagnosticoBtn) {
      cardDiagnosticoBtn.addEventListener('click', function() {
        setActiveTab('diagnostico');
        setTimeout(function() {
          var formElem = document.getElementById('formulario');
          if (formElem) {
            formElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 100);
      });
    }

    // ── DOM ELEMENTS ──
    var form = document.getElementById('diagnostic-form');
    var diasBtns = document.querySelectorAll('.dia-btn');
    var formError = document.getElementById('form-error');
    var resultsSection = document.getElementById('results-section');
    var btnRecalcular = document.getElementById('btn-recalcular');

    // Result elements
    var semaforoCard = document.getElementById('semaforo-card');
    var semaforoIcon = document.getElementById('semaforo-icon');
    var semaforoText = document.getElementById('semaforo-text');
    var semaforoDesc = document.getElementById('semaforo-desc');
    var semaforoGanancia = document.getElementById('semaforo-ganancia');

    var metricMargen = document.getElementById('metric-margen');
    var metricFoodcost = document.getElementById('metric-foodcost');
    var metricFijos = document.getElementById('metric-fijos');
    var metricEquilibrio = document.getElementById('metric-equilibrio');

    var foodcostBar = document.getElementById('foodcost-bar');
    var foodcostBadge = document.getElementById('foodcost-badge');
    var recommendationsList = document.getElementById('recommendations-list');

    // ── STATE ──
    var selectedDias = 6;

    // ── DAYS SELECTION ──
    diasBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectedDias = parseInt(btn.getAttribute('data-dias'));
        diasBtns.forEach(function(b) {
          b.classList.remove('dia-btn--active', 'border-brand-orange', 'text-white', 'bg-brand-orange', 'shadow-md', 'shadow-brand-orange/20');
          b.classList.add('border-brand-navy/10', 'text-brand-navy/60', 'bg-brand-cream-light/30');
        });
        btn.classList.remove('border-brand-navy/10', 'text-brand-navy/60', 'bg-brand-cream-light/30');
        btn.classList.add('dia-btn--active', 'border-brand-orange', 'text-white', 'bg-brand-orange', 'shadow-md', 'shadow-brand-orange/20');
      });
    });

    // ── FORM SUBMISSION ──
    form.addEventListener('submit', function(e) {
      e.preventDefault();

      var ventas = parseFloat(document.getElementById('input-ventas').value);
      var insumos = parseFloat(document.getElementById('input-insumos').value);
      var fijos = parseFloat(document.getElementById('input-fijos').value);
      var plato = parseFloat(document.getElementById('input-plato').value);

      // Validation
      if (!ventas || ventas <= 0 || isNaN(insumos) || insumos < 0 || isNaN(fijos) || fijos < 0 || !plato || plato <= 0) {
        formError.style.display = 'flex';
        formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      formError.style.display = 'none';

      // ── CALCULATIONS ──
      var foodCostPct = (insumos / ventas) * 100;
      var gananciaNeta = ventas - insumos - fijos;
      var margenNeto = (gananciaNeta / ventas) * 100;
      var gastosFijosPct = (fijos / ventas) * 100;

      // Break even (plates per day)
      var costoInsumoPlato = plato * (foodCostPct / 100);
      var contribucionPlato = plato - costoInsumoPlato;
      var diasMes = selectedDias * 4.33;
      var platosDia = 0;
      if (contribucionPlato > 0 && diasMes > 0) {
        platosDia = Math.ceil(fijos / contribucionPlato / diasMes);
      }

      // ── DETERMINE STATUS ──
      var statusLevel, statusText, statusDesc;
      var cardBg, cardBorder, iconBg, iconSvg, gananciaColor;

      if (margenNeto >= 15) {
        statusLevel = 'healthy';
        statusText = '¡Tu negocio está saludable!';
        statusDesc = 'Tu restaurante muestra márgenes positivos. Mantén esta tendencia automatizando tu control financiero diario para no perder el rumbo.';
        cardBg = 'bg-gradient-to-br from-emerald-50 via-white to-emerald-50/50';
        cardBorder = 'border-emerald-200/60';
        iconBg = 'bg-emerald-500';
        iconSvg = '<svg class="w-10 h-10 sm:w-12 sm:h-12 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>';
        gananciaColor = 'text-emerald-600';
      } else if (margenNeto >= 5) {
        statusLevel = 'warning';
        statusText = 'Tu negocio está en riesgo';
        statusDesc = 'Generas ganancia pero los márgenes son ajustados. Una subida en precios de insumos o una caída en ventas podría llevarte a pérdidas rápidamente.';
        cardBg = 'bg-gradient-to-br from-amber-50 via-white to-amber-50/50';
        cardBorder = 'border-amber-200/60';
        iconBg = 'bg-amber-500';
        iconSvg = '<svg class="w-10 h-10 sm:w-12 sm:h-12 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3"></path></svg>';
        gananciaColor = 'text-amber-600';
      } else if (margenNeto >= 0) {
        statusLevel = 'danger';
        statusText = 'Zona crítica';
        statusDesc = 'Tu restaurante apenas sobrevive. Estás al borde de generar pérdidas. Es urgente revisar tus costos y tu estrategia de precios.';
        cardBg = 'bg-gradient-to-br from-red-50 via-white to-red-50/50';
        cardBorder = 'border-red-200/60';
        iconBg = 'bg-red-500';
        iconSvg = '<svg class="w-10 h-10 sm:w-12 sm:h-12 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3"></path></svg>';
        gananciaColor = 'text-red-500';
      } else {
        statusLevel = 'loss';
        statusText = 'Estás perdiendo dinero';
        statusDesc = 'Tu restaurante opera con pérdidas cada mes. Necesitas tomar acción inmediata: reducir costos, renegociar con proveedores o ajustar tus precios de venta.';
        cardBg = 'bg-gradient-to-br from-red-100 via-red-50 to-white';
        cardBorder = 'border-red-300/60';
        iconBg = 'bg-red-600';
        iconSvg = '<svg class="w-10 h-10 sm:w-12 sm:h-12 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>';
        gananciaColor = 'text-red-600';
      }

      // ── UPDATE SEMÁFORO CARD ──
      semaforoCard.className = 'rounded-3xl p-6 sm:p-8 md:p-10 border shadow-lg text-center transition-all duration-500 ' + cardBg + ' ' + cardBorder;
      semaforoIcon.className = 'w-20 h-20 sm:w-24 sm:h-24 rounded-full mx-auto flex items-center justify-center mb-4 shadow-lg ' + iconBg;
      semaforoIcon.innerHTML = iconSvg;
      semaforoText.textContent = statusText;
      semaforoText.className = 'text-2xl sm:text-3xl font-display font-extrabold mb-2 ' + gananciaColor;
      semaforoDesc.textContent = statusDesc;
      semaforoDesc.className = 'text-sm sm:text-base max-w-lg mx-auto leading-relaxed mb-6 text-brand-navy/70';

      // Format currency
      var fmtGanancia = (gananciaNeta < 0 ? '-$' : '$') + Math.abs(gananciaNeta).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      semaforoGanancia.textContent = fmtGanancia;
      semaforoGanancia.className = 'text-xl sm:text-2xl font-display font-black ' + gananciaColor;

      // ── UPDATE METRICS ──
      metricMargen.textContent = margenNeto.toFixed(1) + '%';
      metricFoodcost.textContent = foodCostPct.toFixed(1) + '%';
      metricFijos.textContent = gastosFijosPct.toFixed(1) + '%';
      metricEquilibrio.textContent = contribucionPlato > 0 ? platosDia : '—';

      // Color code metrics
      metricMargen.className = 'text-xl sm:text-2xl font-display font-black ' + (margenNeto >= 15 ? 'text-emerald-600' : margenNeto >= 5 ? 'text-amber-600' : 'text-red-600');
      metricFoodcost.className = 'text-xl sm:text-2xl font-display font-black ' + (foodCostPct <= 35 ? 'text-emerald-600' : foodCostPct <= 45 ? 'text-amber-600' : 'text-red-600');
      metricFijos.className = 'text-xl sm:text-2xl font-display font-black ' + (gastosFijosPct <= 35 ? 'text-emerald-600' : gastosFijosPct <= 50 ? 'text-amber-600' : 'text-red-600');
      metricEquilibrio.className = 'text-xl sm:text-2xl font-display font-black text-brand-navy';

      // ── UPDATE FOOD COST BAR ──
      var barWidth = Math.min(foodCostPct, 60);
      var barPct = (barWidth / 60) * 100;
      var barColor = foodCostPct <= 35 ? 'bg-emerald-500' : foodCostPct <= 45 ? 'bg-amber-500' : 'bg-red-500';
      foodcostBar.style.width = '0%';
      foodcostBar.className = 'absolute top-0 left-0 bottom-0 rounded-full transition-all duration-1000 ease-out ' + barColor;
      setTimeout(function() { foodcostBar.style.width = barPct + '%'; }, 200);

      // Food cost badge
      var badgeText, badgeClass;
      if (foodCostPct <= 28) {
        badgeText = 'Excelente'; badgeClass = 'text-emerald-700 bg-emerald-100 border border-emerald-200';
      } else if (foodCostPct <= 35) {
        badgeText = 'Ideal'; badgeClass = 'text-emerald-700 bg-emerald-100 border border-emerald-200';
      } else if (foodCostPct <= 45) {
        badgeText = 'Elevado'; badgeClass = 'text-amber-700 bg-amber-100 border border-amber-200';
      } else {
        badgeText = 'Crítico'; badgeClass = 'text-red-700 bg-red-100 border border-red-200';
      }
      foodcostBadge.textContent = badgeText;
      foodcostBadge.className = 'text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-lg ' + badgeClass;

      // ── BUILD RECOMMENDATIONS ──
      var tips = [];

      if (margenNeto < 0) {
        tips.push({
          icon: '🚨',
          color: 'border-red-200 bg-red-50',
          title: 'Acción urgente: Estás operando con pérdidas',
          text: 'Cada mes que pasa sin cambios, pierdes $' + Math.abs(gananciaNeta).toFixed(0) + '. Revisa inmediatamente qué gastos puedes reducir o si necesitas ajustar tus precios de venta.'
        });
      }

      if (foodCostPct > 35) {
        tips.push({
          icon: '🛒',
          color: 'border-amber-200 bg-amber-50',
          title: 'Tu costo de insumos está por encima del ideal',
          text: 'Tu food cost es del ' + foodCostPct.toFixed(1) + '% (lo ideal es entre 28% y 35%). Considera renegociar con tu proveedor, ajustar las porciones o revisar recetas para reducir desperdicios.'
        });
      }

      if (gastosFijosPct > 40) {
        tips.push({
          icon: '🏠',
          color: 'border-amber-200 bg-amber-50',
          title: 'Tus gastos fijos están consumiendo mucho',
          text: 'Los gastos fijos representan el ' + gastosFijosPct.toFixed(1) + '% de tus ventas (lo ideal es menos del 35%). Evalúa renegociar tu arriendo, optimizar horarios de empleados o reducir servicios básicos innecesarios.'
        });
      }

      if (margenNeto >= 0 && margenNeto < 10) {
        tips.push({
          icon: '📈',
          color: 'border-brand-teal/20 bg-brand-teal-light',
          title: 'Aumenta tus ventas para respirar mejor',
          text: 'Con un margen del ' + margenNeto.toFixed(1) + '%, cualquier imprevisto puede ponerte en números rojos. Considera crear combos, promover tu plato estrella en redes sociales o ampliar tu horario en días de alta demanda.'
        });
      }

      if (foodCostPct <= 35 && foodCostPct >= 28) {
        tips.push({
          icon: '✅',
          color: 'border-emerald-200 bg-emerald-50',
          title: 'Tu costo de insumos está en rango ideal',
          text: '¡Buen trabajo! Mantienes un food cost del ' + foodCostPct.toFixed(1) + '%, dentro del rango óptimo para restaurantes. Sigue monitoreando mes a mes para que los proveedores no te suban precios sin notarlo.'
        });
      }

      if (margenNeto >= 15) {
        tips.push({
          icon: '🏆',
          color: 'border-emerald-200 bg-emerald-50',
          title: '¡Felicidades! Márgenes saludables',
          text: 'Tu restaurante genera un margen neto del ' + margenNeto.toFixed(1) + '%. El siguiente paso es automatizar este control para mantener la tendencia y detectar anomalías antes de que se conviertan en problemas.'
        });
      }

      if (contribucionPlato > 0) {
        tips.push({
          icon: '🎯',
          color: 'border-brand-orange/15 bg-brand-orange-light',
          title: 'Tu punto de equilibrio diario',
          text: 'Necesitas vender al menos ' + platosDia + ' platos de $' + plato.toFixed(2) + ' cada día que abres para cubrir tus gastos fijos. Todo lo que vendas por encima de esa cantidad es tu ganancia real.'
        });
      }

      // Render recommendations
      var html = '';
      tips.forEach(function(tip) {
        html += '<div class="p-4 rounded-2xl border ' + tip.color + '">';
        html += '<div>';
        html += '<h5 class="text-sm font-bold text-brand-navy mb-1">' + tip.title + '</h5>';
        html += '<p class="text-xs sm:text-sm text-brand-navy/70 leading-relaxed">' + tip.text + '</p>';
        html += '</div>';
        html += '</div>';
      });
      recommendationsList.innerHTML = html;

      // ── SHOW RESULTS ──
      resultsSection.style.display = 'block';
      setTimeout(function() {
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 150);
    });

    // ── RECALCULATE BUTTON ──
    if (btnRecalcular) {
      btnRecalcular.addEventListener('click', function() {
        document.getElementById('formulario').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

  });
})();
</script>
