---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Recursos Gratuitos para Emprendedores - RestoFinance"
  description="Potencia la rentabilidad y gestión de tu negocio gastronómico con nuestras herramientas interactivas, plantillas y guías descargables."
>
  <Header />

  <main class="flex-grow bg-brand-cream-light">

    <!-- ═══════════════════════════════════════ -->
    <!-- PORTAL HERO HEADER                     -->
    <!-- ═══════════════════════════════════════ -->
    <section class="pt-12 sm:pt-16 md:pt-20 pb-6 sm:pb-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-teal bg-brand-teal-light px-4 py-1.5 rounded-full uppercase tracking-wider border border-brand-teal/20 mb-5 select-none font-display">
          🛠️ Centro de Recursos Gratuitos
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-brand-navy tracking-tight mb-4 leading-[1.12]">
          Herramientas y Recursos para <span class="text-brand-orange">Emprendedores</span>
        </h1>
        <p class="text-sm sm:text-base md:text-lg text-brand-navy/70 leading-relaxed max-w-2xl mx-auto">
          Potencia la rentabilidad y gestión de tu negocio gastronómico con nuestras herramientas interactivas, plantillas y guías descargables.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════ -->
    <!-- TABS CONTROLLER (HORIZONTAL)           -->
    <!-- ═══════════════════════════════════════ -->
    <section class="pb-8">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-row justify-center gap-2 bg-white/80 backdrop-blur-md p-1.5 rounded-2xl border border-brand-teal/10 shadow-sm max-w-md mx-auto">
          <button id="tab-inicio-btn" class="flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer bg-brand-orange text-white shadow-md shadow-brand-orange/20">
            Inicio
          </button>
          <button id="tab-diagnostico-btn" class="flex-1 text-center px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-all duration-200 cursor-pointer text-brand-navy/60 hover:text-brand-orange hover:bg-brand-orange-light/40">
            Diagnóstico Financiero
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════ -->
    <!-- INICIO (TODOS LOS RECURSOS) VIEW      -->
    <!-- ═══════════════════════════════════════ -->
    <div id="view-inicio" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 space-y-16 animate-fade-in">
      
      <!-- Resources Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Card 1: Diagnóstico de Rentabilidad -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-brand-teal/10 shadow-sm hover:shadow-md hover:border-brand-teal/20 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex justify-between items-start mb-4">
              <span class="text-[10px] font-bold text-brand-teal bg-brand-teal-light px-2.5 py-1 rounded-lg uppercase tracking-wider">Interactivo / Gratis</span>
            </div>
            <h3 class="text-lg font-display font-extrabold text-brand-navy mb-2 group-hover:text-brand-orange transition-colors">Evaluación de Salud Financiera</h3>
            <p class="text-xs sm:text-sm text-brand-navy/60 leading-relaxed mb-6">Analiza tu margen neto, food cost y punto de equilibrio diario en segundos. Recibe sugerencias dinámicas basadas en tus datos.</p>
          </div>
          <button id="card-diagnostico-btn" class="w-full text-center py-3 rounded-xl text-xs sm:text-sm font-bold text-white bg-brand-navy hover:bg-brand-orange hover:scale-[1.02] transition-all duration-200 cursor-pointer">
            Iniciar Herramienta →
          </button>
        </div>

        <!-- Card 2: Plantilla de Costeo de Platos -->
        <div class="bg-white/60 rounded-3xl p-6 sm:p-8 border border-brand-navy/5 shadow-sm opacity-80 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-4">
              <span class="text-[10px] font-bold text-brand-navy/40 bg-brand-navy/5 px-2.5 py-1 rounded-lg uppercase tracking-wider">Excel / Próximamente</span>
            </div>
            <h3 class="text-lg font-display font-extrabold text-brand-navy/70 mb-2">Recetas y Costeo de Platos</h3>
            <p class="text-xs sm:text-sm text-brand-navy/55 leading-relaxed mb-6">Lleva el cálculo exacto del costo por porción de tus recetas, calcula mermas y determina precios sugeridos de venta.</p>
          </div>
          <button disabled class="w-full text-center py-3 rounded-xl text-xs sm:text-sm font-bold text-brand-navy/40 bg-brand-navy/5 cursor-not-allowed">
            Próximamente
          </button>
        </div>

        <!-- Card 3: Control de Caja Diaria -->
        <div class="bg-white/60 rounded-3xl p-6 sm:p-8 border border-brand-navy/5 shadow-sm opacity-80 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-4">
              <span class="text-[10px] font-bold text-brand-navy/40 bg-brand-navy/5 px-2.5 py-1 rounded-lg uppercase tracking-wider">Excel / Próximamente</span>
            </div>
            <h3 class="text-lg font-display font-extrabold text-brand-navy/70 mb-2">Flujo de Caja y Ventas Diarias</h3>
            <p class="text-xs sm:text-sm text-brand-navy/55 leading-relaxed mb-6">Evita descuadres al cerrar tu caja diaria. Registra efectivo, transferencias digitales y salidas rápidas de caja.</p>
          </div>
          <button disabled class="w-full text-center py-3 rounded-xl text-xs sm:text-sm font-bold text-brand-navy/40 bg-brand-navy/5 cursor-not-allowed">
            Próximamente
          </button>
        </div>

      </div>

      <!-- ══ RESTOFINANCE ULTRA-PREMIUM SHOWCASE (DEFAULT HOME PRESENTATION) ══ -->
      <div class="bg-gradient-to-br from-brand-navy via-brand-navy to-brand-navy-light rounded-3xl p-8 sm:p-12 md:p-16 text-left relative overflow-hidden shadow-2xl border border-white/10 group">
        
        <!-- Background Tech Grid Overlay -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
        
        <!-- Glowing Ambient Lighting -->
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-brand-orange/20 rounded-full blur-[100px] pointer-events-none group-hover:bg-brand-orange/25 transition-all duration-500"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-brand-teal/20 rounded-full blur-[100px] pointer-events-none group-hover:bg-brand-teal/25 transition-all duration-500"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-brand-orange/5 rounded-full blur-[100px] pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-orange bg-brand-orange/15 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
              Lleva tu restaurante al siguiente nivel
            </span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-white leading-[1.12] tracking-tight">
              ¿Por qué seguir controlando tu negocio a ciegas?
            </h2>
            <p class="text-sm sm:text-base md:text-lg text-white/80 leading-relaxed font-normal">
              Las hojas de cálculo y las calculadoras manuales son lentas y propensas a errores. <strong class="text-white">RestoFinance</strong> es el sistema de punto de venta y finanzas definitivo que funciona localmente, sin depender de internet.
            </p>
            
            <!-- Features List -->
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-white/90 text-sm md:text-base">
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-brand-orange shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span>Ventas y caja en tiempo real</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span>Costo de recetas e insumos</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-brand-orange shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span>Utilidad neta mensual automática</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span>Funciona sin internet al 100%</span>
              </li>
            </ul>

            <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
              <a 
                href="https://github.com/Francisco-jvcmd/RestoFinance-Instalador/releases/download/v1.0.0/RestoFinance_1.0.0_x64-setup.exe"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4.5 rounded-2xl text-sm sm:text-base font-extrabold text-white bg-brand-orange hover:bg-brand-orange-hover hover:scale-[1.03] active:scale-[0.97] shadow-xl shadow-brand-orange/30 hover:shadow-brand-orange/45 transition-all duration-200"
              >
                <svg class="w-5.5 h-5.5" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.45H0V3.449zM0 12.45h9.75v9.45L0 20.551v-8.102zM10.95 1.95L24 0v11.55H10.95V1.95zM10.95 12.45H24v9.6L10.95 22.05v-9.6z"/></svg>
                Descargar Gratis
              </a>
              <a 
                href="/#precios"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4.5 rounded-2xl text-sm sm:text-base font-bold text-white/90 hover:text-white bg-white/10 hover:bg-white/15 border border-white/15 hover:border-white/25 hover:scale-[1.03] active:scale-[0.97] transition-all duration-200"
              >
                Ver Planes de Licencia
              </a>
            </div>
          </div>
          
          <!-- Premium Graphical Mockup Showcase -->
          <div class="hidden lg:flex lg:col-span-5 relative mt-8 lg:mt-0 justify-center">
            <div class="relative bg-white/5 border border-white/10 rounded-2xl p-5 w-full max-w-[320px] shadow-2xl backdrop-blur-md transition-transform duration-300 hover:scale-[1.02]">
              <!-- Mock Window Titlebar -->
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 text-xs font-semibold text-white/60">
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-red-500/80"></span>
                  <span class="w-2 h-2 rounded-full bg-yellow-500/80"></span>
                  <span class="w-2 h-2 rounded-full bg-green-500/80"></span>
                </div>
                <span>RestoFinance Desktop v1.0.0</span>
              </div>
              
              <!-- Content Stats Mockup -->
              <div class="space-y-3">
                <div class="bg-white/[0.04] rounded-xl p-3 border border-white/5">
                  <span class="text-[9px] text-white/50 block uppercase font-bold tracking-wider mb-1">Margen Neto Mensual</span>
                  <div class="flex justify-between items-baseline">
                    <span class="text-xl font-display font-black text-brand-orange">32.4%</span>
                    <span class="text-[9px] text-emerald-400 font-bold bg-emerald-400/10 px-1.5 py-0.5 rounded">Saludable</span>
                  </div>
                </div>
                <div class="bg-white/[0.04] rounded-xl p-3 border border-white/5">
                  <span class="text-[9px] text-white/50 block uppercase font-bold tracking-wider mb-1">Ventas Totales</span>
                  <span class="text-lg font-display font-bold text-white">$ 4,850.00</span>
                </div>
                <div class="bg-white/[0.04] rounded-xl p-3 border border-white/5">
                  <span class="text-[9px] text-white/50 block uppercase font-bold tracking-wider mb-1">Punto de Equilibrio</span>
                  <div class="flex items-center gap-2 mt-1">
                    <div class="w-full bg-white/10 rounded-full h-1.5">
                      <div class="bg-brand-teal h-1.5 rounded-full" style="width: 100%;"></div>
                    </div>
                    <span class="text-[10px] text-brand-teal font-extrabold shrink-0">100%</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- ═══════════════════════════════════════ -->
    <!-- VIEW: DIAGNOSTICO TOOL                 -->
    <!-- ═══════════════════════════════════════ -->
    <div id="view-diagnostico" class="hidden">
      
      <!-- HOW IT WORKS (3 Steps)                 -->
      <section class="pb-10 sm:pb-14">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-5">

            <div class="flex sm:flex-col items-center sm:items-center gap-3 sm:gap-2.5 bg-white/70 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-brand-orange/8 shadow-sm sm:text-center">
              <span class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-orange-light text-brand-orange flex items-center justify-center font-display font-extrabold text-base sm:text-lg">1</span>
              <div>
                <h3 class="text-sm font-bold text-brand-navy">Ingresa tus datos</h3>
                <p class="text-[11px] sm:text-xs text-brand-navy/50 mt-0.5">5 datos básicos de tu restaurante</p>
              </div>
            </div>

            <div class="flex sm:flex-col items-center sm:items-center gap-3 sm:gap-2.5 bg-white/70 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-brand-teal/8 shadow-sm sm:text-center">
              <span class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-teal-light text-brand-teal flex items-center justify-center font-display font-extrabold text-base sm:text-lg">2</span>
              <div>
                <h3 class="text-sm font-bold text-brand-navy">Recibe tu diagnóstico</h3>
                <p class="text-[11px] sm:text-xs text-brand-navy/50 mt-0.5">Análisis instantáneo de rentabilidad</p>
              </div>
            </div>

            <div class="flex sm:flex-col items-center sm:items-center gap-3 sm:gap-2.5 bg-white/70 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-brand-orange/8 shadow-sm sm:text-center">
              <span class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-orange-light text-brand-orange flex items-center justify-center font-display font-extrabold text-base sm:text-lg">3</span>
              <div>
                <h3 class="text-sm font-bold text-brand-navy">Toma acción</h3>
                <p class="text-[11px] sm:text-xs text-brand-navy/50 mt-0.5">Recomendaciones personalizadas</p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- DIAGNOSTIC FORM                        -->
      <section class="pb-16" id="formulario">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="bg-white rounded-3xl p-6 sm:p-8 md:p-10 border border-brand-orange/10 shadow-lg relative overflow-hidden">

            <!-- Decorative corner -->
            <div class="absolute top-0 right-0 w-36 h-36 bg-brand-orange/[0.03] rounded-bl-full pointer-events-none"></div>

            <h2 class="text-lg sm:text-xl font-display font-extrabold text-brand-navy mb-1 relative z-10">
              Datos de tu Restaurante
            </h2>
            <p class="text-xs sm:text-sm text-brand-navy/50 mb-8 relative z-10">
              Completa los 5 campos con información aproximada. No necesita ser exacta.
            </p>

            <form id="diagnostic-form" class="space-y-6 relative z-10" novalidate>

              <!-- Field 1: Ventas mensuales -->
              <div class="space-y-1.5">
                <label for="input-ventas" class="flex items-center gap-2 text-sm font-bold text-brand-navy">
                  <span class="text-base leading-none">💰</span> Ventas mensuales aproximadas
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-navy/35 font-bold text-sm select-none pointer-events-none">$</span>
                  <input 
                    type="number" 
                    id="input-ventas" 
                    min="0" max="500000" step="50" 
                    placeholder="3000"
                    required
                    class="w-full pl-9 pr-4 py-3.5 sm:py-4 rounded-2xl border-2 border-brand-navy/10 bg-brand-cream-light/30 text-brand-navy font-bold text-base sm:text-lg focus:border-brand-orange focus:ring-4 focus:ring-brand-orange/10 transition-all duration-200 outline-none placeholder:text-brand-navy/20 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                </div>
                <p class="text-[11px] text-brand-navy/40 pl-1">Todo el dinero que entra a tu negocio en un mes (efectivo + transferencias)</p>
              </div>

              <!-- Field 2: Costo de insumos -->
              <div class="space-y-1.5">
                <label for="input-insumos" class="flex items-center gap-2 text-sm font-bold text-brand-navy">
                  <span class="text-base leading-none">🛒</span> Compras del mercado / insumos al mes
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-navy/35 font-bold text-sm select-none pointer-events-none">$</span>
                  <input 
                    type="number" 
                    id="input-insumos" 
                    min="0" max="500000" step="50" 
                    placeholder="1200"
                    required
                    class="w-full pl-9 pr-4 py-3.5 sm:py-4 rounded-2xl border-2 border-brand-navy/10 bg-brand-cream-light/30 text-brand-navy font-bold text-base sm:text-lg focus:border-brand-orange focus:ring-4 focus:ring-brand-orange/10 transition-all duration-200 outline-none placeholder:text-brand-navy/20 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                </div>
                <p class="text-[11px] text-brand-navy/40 pl-1">Lo que gastas en carne, verduras, arroz, aceite y todos los ingredientes</p>
              </div>

              <!-- Field 3: Gastos fijos -->
              <div class="space-y-1.5">
                <label for="input-fijos" class="flex items-center gap-2 text-sm font-bold text-brand-navy">
                  <span class="text-base leading-none">🏠</span> Gastos fijos mensuales
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-navy/35 font-bold text-sm select-none pointer-events-none">$</span>
                  <input 
                    type="number" 
                    id="input-fijos" 
                    min="0" max="500000" step="50" 
                    placeholder="800"
                    required
                    class="w-full pl-9 pr-4 py-3.5 sm:py-4 rounded-2xl border-2 border-brand-navy/10 bg-brand-cream-light/30 text-brand-navy font-bold text-base sm:text-lg focus:border-brand-orange focus:ring-4 focus:ring-brand-orange/10 transition-all duration-200 outline-none placeholder:text-brand-navy/20 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                </div>
                <p class="text-[11px] text-brand-navy/40 pl-1">Alquiler + luz + agua + sueldos + gas + otros gastos fijos cada mes</p>
              </div>

              <!-- Field 4: Días por semana -->
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-sm font-bold text-brand-navy">
                  <span class="text-base leading-none">📅</span> ¿Cuántos días abres a la semana?
                </label>
                <div class="flex gap-3" id="dias-group">
                  <button type="button" data-dias="5" class="dia-btn flex-1 py-3 sm:py-3.5 rounded-2xl border-2 border-brand-navy/10 text-sm font-bold text-brand-navy/60 hover:border-brand-orange/40 hover:text-brand-orange transition-all duration-200 bg-brand-cream-light/30 cursor-pointer">
                    5 días
                  </button>
                  <button type="button" data-dias="6" class="dia-btn dia-btn--active flex-1 py-3 sm:py-3.5 rounded-2xl border-2 border-brand-orange text-sm font-bold text-white bg-brand-orange shadow-md shadow-brand-orange/20 transition-all duration-200 cursor-pointer">
                    6 días
                  </button>
                  <button type="button" data-dias="7" class="dia-btn flex-1 py-3 sm:py-3.5 rounded-2xl border-2 border-brand-navy/10 text-sm font-bold text-brand-navy/60 hover:border-brand-orange/40 hover:text-brand-orange transition-all duration-200 bg-brand-cream-light/30 cursor-pointer">
                    7 días
                  </button>
                </div>
              </div>

              <!-- Field 5: Precio plato estrella -->
              <div class="space-y-1.5">
                <label for="input-plato" class="flex items-center gap-2 text-sm font-bold text-brand-navy">
                  <span class="text-base leading-none">⭐</span> Precio de tu plato más vendido
                </label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-navy/35 font-bold text-sm select-none pointer-events-none">$</span>
                  <input 
                    type="number" 
                    id="input-plato" 
                    min="0" max="1000" step="0.25" 
                    placeholder="3.50"
                    required
                    class="w-full pl-9 pr-4 py-3.5 sm:py-4 rounded-2xl border-2 border-brand-navy/10 bg-brand-cream-light/30 text-brand-navy font-bold text-base sm:text-lg focus:border-brand-orange focus:ring-4 focus:ring-brand-orange/10 transition-all duration-200 outline-none placeholder:text-brand-navy/20 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                </div>
                <p class="text-[11px] text-brand-navy/40 pl-1">El precio de venta al público del platillo que más vendes</p>
              </div>

              <!-- Validation Error -->
              <div id="form-error" class="p-4 rounded-2xl bg-red-50 border border-red-200 text-sm text-red-700 font-medium flex items-center gap-2" style="display:none;">
